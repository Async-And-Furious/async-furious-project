generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxIdType {
  CPF
  CNPJ
}

enum SOStatus {
  RECEIVED
  UNDER_DIAGNOSIS
  AWAITING_APPROVAL
  IN_PROGRESS
  AWAITING_PARTS
  FINISHED
  DELIVERED
  CLOSED_WITHOUT_EXECUTION
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  role       String   @default("admin")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Cliente {
  id             String    @id @default(uuid())
  nome           String
  email          String    @unique
  telefone       String?
  documento      String    @unique
  tipo_documento TaxIdType
  ativo          Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  veiculos      Veiculo[]
  ordensServico OrdemServico[]
}

model Veiculo {
  id         String   @id @default(uuid())
  placa      String   @unique
  marca      String
  modelo     String
  ano        Int
  cor        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  id_cliente    String
  cliente       Cliente        @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  ordensServico OrdemServico[]
}

model OrdemServico {
  id                     String    @id @default(uuid())
  id_veiculo             String
  id_cliente             String
  status                 SOStatus  @default(RECEIVED)
  descricao              String?
  iniciada_em            DateTime?
  finalizada_em          DateTime?
  entregue_em            DateTime?
  // Reserva de peças pendente (sem estoque): decide AWAITING_PARTS ao consumir ExecucaoIniciada
  reserva_pecas_pendente Boolean   @default(false)
  // Pagamento confirmado pelo Billing (PagamentoConfirmado): não muda o status; o detector de
  // OS parada só considera OS em AWAITING_APPROVAL com pago_em nulo (ADR-0018)
  pago_em                DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  // Restrict (#378, item 2): apagar cliente ou veículo não apaga mais as OS.
  veiculo         Veiculo             @relation(fields: [id_veiculo], references: [id], onDelete: Restrict)
  cliente         Cliente             @relation(fields: [id_cliente], references: [id], onDelete: Restrict)
  osPecas         OsPeca[]
  osServicos      OsServico[]
  historicoStatus HistoricoStatusOS[]
}

model Peca {
  id                 String   @id @default(uuid())
  nome               String
  codigo             String   @unique
  descricao          String?
  preco              Decimal  @db.Decimal(10, 2)
  quantidade_estoque Int      @default(0)
  quantidade_minima  Int      @default(1)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  osPecas               OsPeca[]
  pedidoFornecedorItens PedidoFornecedorItem[]
}

model Servico {
  id         String   @id @default(uuid())
  nome       String
  descricao  String?
  preco      Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  osServicos OsServico[]
}

model OsPeca {
  id               String   @id @default(uuid())
  id_ordem_servico String
  id_peca          String
  quantidade       Int
  preco_unitario   Decimal  @db.Decimal(10, 2)
  valor_total      Decimal  @db.Decimal(10, 2)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  ordem_servico OrdemServico @relation(fields: [id_ordem_servico], references: [id], onDelete: Cascade)
  peca          Peca         @relation(fields: [id_peca], references: [id], onDelete: Restrict)

  @@unique([id_ordem_servico, id_peca])
}

model OsServico {
  id               String   @id @default(uuid())
  id_ordem_servico String
  id_servico       String
  quantidade       Int      @default(1)
  preco_unitario   Decimal  @db.Decimal(10, 2)
  valor_total      Decimal  @db.Decimal(10, 2)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  ordem_servico OrdemServico @relation(fields: [id_ordem_servico], references: [id], onDelete: Cascade)
  servico       Servico      @relation(fields: [id_servico], references: [id], onDelete: Restrict)

  @@unique([id_ordem_servico, id_servico])
}

model PedidoFornecedor {
  id            String   @id @default(uuid())
  fornecedor_id String
  status        String   @default("PENDENTE") // PENDENTE | RECEBIDO
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  itens PedidoFornecedorItem[]
}

model PedidoFornecedorItem {
  id                    String @id @default(uuid())
  id_pedido_fornecedor  String
  id_peca               String
  quantidade_solicitada Int
  quantidade_recebida   Int    @default(0)

  pedido_fornecedor PedidoFornecedor @relation(fields: [id_pedido_fornecedor], references: [id], onDelete: Cascade)
  peca              Peca             @relation(fields: [id_peca], references: [id], onDelete: Restrict)
}

model ReservaEstoque {
  id           String   @id @default(uuid())
  ordem_id     String
  peca_id      String
  quantidade   Int
  reservado_em DateTime @default(now())

  @@unique([ordem_id, peca_id])
}

model HistoricoStatusOS {
  id               String    @id @default(uuid())
  ordem_servico_id String
  status_anterior  SOStatus?
  status_novo      SOStatus
  motivo           String?
  data_hora        DateTime  @default(now())

  ordem_servico OrdemServico @relation(fields: [ordem_servico_id], references: [id], onDelete: Cascade)

  @@map("historico_status_os")
}
