generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxIdType {
  CPF
  CNPJ
}

enum SOStatus {
  RECEIVED
  UNDER_DIAGNOSIS
  AWAITING_APPROVAL
  IN_PROGRESS
  FINISHED
  DELIVERED
}

enum EstimateStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Cliente {
  id             String    @id @default(uuid())
  nome           String    @map("name")
  email          String    @unique
  telefone       String?   @map("phone")
  documento      String    @unique @map("tax_id")
  tipo_documento TaxIdType @map("tax_id_type")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  veiculos        Veiculo[]
  ordensServico   OrdemServico[]

  @@map("Customer")
}

model Veiculo {
  id         String   @id @default(uuid())
  placa      String   @unique @map("license_plate")
  marca      String   @map("brand")
  modelo     String   @map("model")
  ano        Int      @map("year")
  cor        String?  @map("color")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente         Cliente        @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  id_cliente      String         @map("customer_id")
  ordensServico   OrdemServico[]

  @@map("Vehicle")
}

model OrdemServico {
  id          String    @id @default(uuid())
  id_veiculo  String    @map("vehicle_id")
  id_cliente  String    @map("customer_id")
  status      SOStatus  @default(RECEIVED)
  descricao   String?   @map("description")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  entregue_em DateTime? @map("delivered_at")

  veiculo   Veiculo    @relation(fields: [id_veiculo], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  orcamento Orcamento?

  @@map("ServiceOrder")
}

model Orcamento {
  id                   String         @id @default(uuid())
  id_ordem_servico     String         @unique @map("service_order_id")
  valor_total_servicos Decimal        @default(0) @db.Decimal(10, 2) @map("total_services_value")
  valor_total_pecas    Decimal        @default(0) @db.Decimal(10, 2) @map("total_parts_value")
  valor_total_geral    Decimal        @default(0) @db.Decimal(10, 2) @map("total_general_value")
  status               EstimateStatus @default(PENDING) @map("estimate_status")
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  ordem_servico OrdemServico @relation(fields: [id_ordem_servico], references: [id], onDelete: Cascade)
}

model Peca {
  id                 String   @id @default(uuid())
  nome               String
  codigo             String   @unique
  descricao          String?
  preco              Decimal  @db.Decimal(10, 2)
  quantidade_estoque Int      @default(0)
  quantidade_minima  Int      @default(1)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model Servico {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  preco       Decimal  @db.Decimal(10, 2)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Pagamento {
  id             String   @id @default(uuid())
  ordemServicoId String
  valor          Decimal  @db.Decimal(10, 2)
  status         String
  createdAt      DateTime @default(now())

  @@map("pagamentos")
}
