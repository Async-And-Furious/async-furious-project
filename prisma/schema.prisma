generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaxIdType {
  CPF
  CNPJ
}

enum SOStatus {
  RECEIVED
  UNDER_DIAGNOSIS
  AWAITING_APPROVAL
  IN_PROGRESS
  FINISHED
  DELIVERED
}

enum EstimateStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Customer {
  id             String    @id @default(uuid())
  nome           String    @map("name")
  email          String    @unique
  telefone       String?   @map("phone")
  documento      String    @unique @map("tax_id")
  tipo_documento TaxIdType @map("tax_id_type")
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  veiculos       Vehicle[]
  ordens_servico ServiceOrder[]
}

model Vehicle {
  id         String   @id @default(uuid())
  placa      String   @unique @map("license_plate")
  marca      String   @map("brand")
  modelo     String   @map("model")
  ano        Int      @map("year")
  cor        String?  @map("color")
  id_cliente String   @map("customer_id")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente        Customer       @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  ordens_servico ServiceOrder[]
}

model ServiceOrder {
  id          String    @id @default(uuid())
  id_veiculo  String    @map("vehicle_id")
  id_cliente  String    @map("customer_id")
  status      SOStatus  @default(RECEIVED)
  descricao   String?   @map("description")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  entregue_em DateTime? @map("delivered_at")

  veiculo  Vehicle  @relation(fields: [id_veiculo], references: [id], onDelete: Cascade)
  cliente  Customer @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
}

model Peca {
  id                 String   @id @default(uuid())
  nome               String
  codigo             String   @unique
  descricao          String?
  preco              Decimal  @db.Decimal(10, 2)
  quantidade_estoque Int      @default(0)
  quantidade_minima  Int      @default(1)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}
