DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workshop"
# Read model (ADR-0019): local usa o mongo do docker-compose.dependencies.yml.
# Em HML/PROD a conexão vem de DOCDB_HOST/PORT/USER/PASSWORD (secret tc3-docdb-os-<env>).
DOCDB_URI="mongodb://localhost:27017"
DOCDB_NAME="os_read_model"
AUTH_MODE="local"
JWT_SECRET="change-me-in-production-use-openssl-rand-hex-32"
JWT_PUBLIC_KEY=""
JWT_ISSUER=""
JWT_AUDIENCE=""
WEBHOOK_SECRET="local-webhook-secret"
JWT_EXPIRATION="3600"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_IN="1800"
JWT_CUSTOMER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMII...\n-----END PUBLIC KEY-----"
BCRYPT_SALT_ROUNDS="10"
# Mercado Pago (Checkout Pro): token da aba "Teste" do painel; o valor real fica só no .env
MP_ACCESS_TOKEN=""
# Opcional: URL pública do webhook (ngrok/cloudflared), enviada como notification_url da preference
MP_NOTIFICATION_URL=""
# Chave do painel (Suas integrações → aplicação → Webhooks → Configurar notificação); valida o x-signature
MP_WEBHOOK_SECRET=""
SEED_ADMIN_EMAIL="admin@example.invalid"
SEED_ADMIN_PASSWORD="replace-with-disposable-local-secret"
SEED_RECEPCIONISTA_PASSWORD="replace-with-disposable-local-secret"
SEED_MECANICO_PASSWORD="replace-with-disposable-local-secret"
NEW_RELIC_NO_CONFIG_FILE="true"
NEW_RELIC_APP_NAME="async-furious-project"
NEW_RELIC_LICENSE_KEY=""
NEW_RELIC_APPLICATION_LOGGING_ENABLED="true"
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED="false"
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED="true"
